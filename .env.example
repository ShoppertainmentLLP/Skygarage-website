# Runtime only — read via process.env on the server. Never referenced through import.meta.env,
# which would bake the build machine's value into the bundle and shadow the host's.
DATABASE_URL=postgres://cars911:cars911@localhost:5433/cars911
ADMIN_PASSWORD=change-me

# Build-time — Vite inlines these, so they must be present when `astro build` runs (they are
# Docker build args). They are identifiers, not secrets.
PUBLIC_WHATSAPP_NUMBER=971501234567
PUBLIC_PHONE_NUMBER=+971501234567

# Optional, all inert when unset:
# PUBLIC_GOOGLE_SITE_VERIFICATION=   # Search Console HTML-tag method
# PUBLIC_BING_SITE_VERIFICATION=     # Bing Webmaster Tools
# PUBLIC_GA4_ID=                     # e.g. G-XXXXXXXXXX. Re-measure TBT/INP after enabling.
