---
import { phoneDisplay, telLink, waLink } from '../lib/site';

const path = Astro.url.pathname;

const bookLinks: [string, string][] = [
  ['/book-a-service/', 'Book a car service'],
  ['/book/appointment/', 'Book appointment'],
  ['/book/emergency/', 'Emergency booking'],
  ['/book/corporate/', 'Corporate booking'],
  ['/book/packages/', 'Service packages'],
  ['/book/compare/', 'Compare garages'],
];
const serviceLinks: [string, string][] = [
  ['/services/car-service/', 'Car Service'],
  ['/services/car-repair/', 'Car Repair'],
  ['/services/body-shop/', 'Body Shop'],
  ['/services/roadside-assistance/', 'Roadside Assistance'],
  ['/services/', 'All services'],
];
const flatLinks: [string, string][] = [
  ['/brands/', 'Brands'],
  ['/locations/', 'Locations'],
  ['/garages/', 'Garages'],
  ['/blog/', 'Blog'],
  ['/about/', 'About'],
];

const isCurrent = (href: string) => path === href || path.startsWith(`${href}/`);
// The gold rule under the current section is the only place colour marks position.
const markCurrent = (href: string) =>
  isCurrent(href) ? 'border-gold' : 'border-transparent hover:border-white/30';
---

<header class="sticky top-0 z-40 border-b border-gold/30 bg-ink/95 text-white backdrop-blur-sm">
  <div class="spine flex h-16 items-stretch gap-4 xl:gap-5">
    <a
      href="/"
      class="flex shrink-0 items-center gap-2.5"
      aria-label="Cars911 home"
      aria-current={path === '/' ? 'page' : undefined}
    >
      <img src="/brand/mark.webp" alt="" width="188" height="80" fetchpriority="high" decoding="async" class="h-7 w-auto aspect-[188/80]" />
      <span class="text-[1.375rem] font-extrabold tracking-[0.005em] [font-variation-settings:'wdth'_84]">
        Cars<span class="text-gold-light">911</span>
      </span>
    </a>

    <nav class="hidden flex-1 items-stretch gap-1 text-[0.9375rem] lg:flex" aria-label="Main">
      <div class="group relative flex">
        <a
          href="/book-a-service/"
          class={`flex h-full items-center whitespace-nowrap border-b-2 px-3 font-medium ${markCurrent('/book/')}`}
          aria-expanded="false"
        >
          Book
        </a>
        <div
          class="invisible absolute left-0 top-full min-w-56 border border-gold/30 bg-ink py-1.5 opacity-0 transition-opacity group-focus-within:visible group-focus-within:opacity-100 group-hover:visible group-hover:opacity-100"
        >
          {bookLinks.map(([href, label]) => (
            <a href={href} class="block px-4 py-2 font-medium hover:bg-ink-raise hover:text-gold-light" aria-current={path === href ? 'page' : undefined}>{label}</a>
          ))}
        </div>
      </div>

      <div class="group relative flex">
        <a href="/services/" class={`flex h-full items-center whitespace-nowrap border-b-2 px-3 font-medium ${markCurrent('/services/')}`}>
          Services
        </a>
        <div
          class="invisible absolute left-0 top-full min-w-56 border border-gold/30 bg-ink py-1.5 opacity-0 transition-opacity group-focus-within:visible group-focus-within:opacity-100 group-hover:visible group-hover:opacity-100"
        >
          {serviceLinks.map(([href, label]) => (
            <a href={href} class="block px-4 py-2 font-medium hover:bg-ink-raise hover:text-gold-light" aria-current={path === href ? 'page' : undefined}>{label}</a>
          ))}
        </div>
      </div>

      {flatLinks.map(([href, label]) => (
        <a href={href} class={`flex h-full items-center whitespace-nowrap border-b-2 px-2.5 font-medium ${markCurrent(href)}`} aria-current={isCurrent(href) ? 'page' : undefined}>
          {label}
        </a>
      ))}
    </nav>

    <!--
      Calling and WhatsApp are how most of this traffic actually converts, so on desktop they
      sit beside the quote button rather than only in the mobile bar (sheet item 1). They appear
      from 1280px up: the row is capped at the spine's 1152px and the nav plus the quote button
      already fill a 1024px one, so adding them any earlier pushes the button off the edge.
      The number itself stays in the footer and the mobile bar, where there is room to read it.
    -->
    <div class="ml-auto hidden items-center gap-4 lg:flex xl:gap-3">
      <a href="/rsa/" class="flex items-center gap-2 whitespace-nowrap text-[0.9375rem] font-medium text-alert-bright hover:underline hover:underline-offset-4">
        <span class="size-1.5 rounded-full bg-alert-bright" aria-hidden="true"></span>
        Roadside help
      </a>
      <a
        href={telLink()}
        class="hidden items-center gap-2 whitespace-nowrap text-[0.9375rem] font-medium hover:text-gold-light xl:flex"
        aria-label={`Call Cars911 on ${phoneDisplay()}`}
      >
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="size-[1.125rem]" aria-hidden="true">
          <path d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.24 11.4 11.4 0 0 0 3.6.58 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1 11.4 11.4 0 0 0 .58 3.6 1 1 0 0 1-.25 1Z" />
        </svg>
        Call
      </a>
      <a
        href={waLink('Hi Cars911, I need help with my car.')}
        class="hidden items-center gap-2 whitespace-nowrap text-[0.9375rem] font-medium hover:text-gold-light xl:flex"
        aria-label="WhatsApp Cars911"
      >
        <svg viewBox="0 0 24 24" fill="currentColor" class="size-[1.125rem]" aria-hidden="true">
          <path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm0 18.2a8.2 8.2 0 0 1-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2Zm4.6-6.1c-.25-.13-1.48-.73-1.7-.81-.23-.09-.4-.13-.56.12-.17.25-.64.8-.79.97-.14.16-.29.18-.54.06a6.7 6.7 0 0 1-1.97-1.22 7.4 7.4 0 0 1-1.36-1.7c-.14-.25-.01-.38.11-.5.11-.11.25-.29.37-.44.12-.15.16-.25.25-.42.08-.16.04-.31-.02-.44-.06-.12-.56-1.35-.77-1.85-.2-.48-.4-.42-.55-.43h-.47c-.16 0-.42.06-.64.31-.22.25-.84.82-.84 2s.86 2.32.98 2.48c.12.17 1.7 2.6 4.12 3.65.58.25 1.03.4 1.38.51.58.19 1.1.16 1.52.1.46-.07 1.42-.58 1.62-1.14.2-.56.2-1.04.14-1.14-.06-.1-.22-.16-.47-.28Z" />
        </svg>
      </a>
      <a href="/book-a-service/" class="btn btn-primary whitespace-nowrap py-2.5 text-[0.875rem]">Get quotes</a>
    </div>

    <details class="relative ml-auto flex items-center lg:hidden">
      <summary class="cursor-pointer list-none border border-gold/40 px-3 py-2 text-[0.9375rem] font-medium text-gold-light">
        Menu
      </summary>
      <nav class="absolute right-0 top-full mt-2 w-64 border border-gold/30 bg-ink py-1.5" aria-label="Mobile">
        {[...bookLinks, ...serviceLinks, ...flatLinks].map(([href, label]) => (
          <a href={href} class="block px-4 py-2 font-medium hover:bg-ink-raise hover:text-gold-light">{label}</a>
        ))}
        <a href="/rsa/" class="block border-t border-gold/30 px-4 py-2.5 font-medium text-alert-bright">Roadside help</a>
      </nav>
    </details>
  </div>
</header>
