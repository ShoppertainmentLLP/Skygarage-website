---
import CtaPair from './CtaPair.astro';

interface Props {
  heading?: string;
  bookHref?: string;
  bookLabel?: string;
}

const {
  heading = 'One request. Multiple quotes.',
  bookHref,
  bookLabel,
} = Astro.props;
---

<!-- Pages close on the same action pair they opened with. -->
<section class="border-t border-rule">
  <div class="spine py-14 md:py-16">
    <div class="flex flex-wrap items-center justify-between gap-8">
      <div>
        <h2 class="title">{heading}</h2>
        {Astro.slots.has('default') && <p class="lede mt-4"><slot /></p>}
      </div>
      <CtaPair tone="dark" bookHref={bookHref} bookLabel={bookLabel} />
    </div>
  </div>
</section>
