---
import { priceLabel } from '../../lib/site';
import { serviceUrl } from '../../lib/urls';

/* Two or three neighbouring jobs, chosen in the copy file rather than by category accident. */
interface Props {
  heading: string;
  services: { id: number; name: string; excerpt: string; seoSlug: string; slug: string; priceFromAed: number | null; priceToAed: number | null }[];
  class?: string;
}
const { heading, services, class: klass = '' } = Astro.props;
---

{services.length > 0 && (
  <section class={klass}>
    <h2 class="title">{heading}</h2>
    <ul class="mt-8 grid gap-6 md:grid-cols-3">
      {services.map((s) => (
        <li class="sheet flex flex-col p-6">
          <h3 class="title-sm">
            <a href={serviceUrl(s)} class="hover:text-gold-light">{s.name}</a>
          </h3>
          <p class="mt-3 flex-1 text-[0.9375rem] leading-relaxed text-graphite">{s.excerpt}</p>
          <p class="mt-4 text-[0.9375rem] font-medium">{priceLabel(s.priceFromAed, s.priceToAed)}</p>
        </li>
      ))}
    </ul>
  </section>
)}
