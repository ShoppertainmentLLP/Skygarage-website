---
import { serviceUrl } from '../lib/urls';
import BaseLayout from '../layouts/BaseLayout.astro';
import { telLink, waLink, phoneDisplay } from '../lib/site';
import { getCategoriesWithServices } from '../lib/queries';

const categories = await getCategoriesWithServices();
const roadside = categories.find((c) => c.slug === 'roadside-assistance');
const services = roadside?.services ?? [];

const alsoCovered = ['Fuel delivery', 'Lockout assistance', 'On-the-spot minor fixes'];
---

<BaseLayout
  title="Roadside assistance (RSA) — help anywhere in the UAE"
  description="Cars911 roadside assistance: jump starts, tyre changes, fuel delivery, lockouts and towing, anywhere in the UAE. WhatsApp or call for immediate dispatch."
>
  <!--
    The one page someone opens in a hurry. It stays on the dark surface so it is
    unmistakably a different mode, and the phone number is the largest thing on it.
  -->
  <section class="bg-ink text-white">
    <div class="spine py-16 md:py-20">
      <div class="grid gap-12 lg:grid-cols-12 lg:gap-16">
        <div class="lg:col-span-7">
          <h1 class="display">
            Stuck?<br />
            <span class="said-in-gold">Help is one message away.</span>
          </h1>
          <p class="mt-6 max-w-lg text-xl leading-relaxed text-white/75">
            Tell us where you are and what happened. The nearest recovery unit or mobile mechanic
            is dispatched immediately, 24 hours a day, across all emirates.
          </p>
        </div>

        <div class="flex flex-col justify-end lg:col-span-5">
          <a href={telLink()} class="figure block text-[2.5rem] leading-none text-gold-light hover:text-white">
            {phoneDisplay()}
          </a>
          <p class="mt-2 text-white/60">Call any time, any emirate.</p>
          <a
            href={waLink('EMERGENCY: I need roadside assistance. My location: ')}
            class="btn mt-7 self-start bg-whatsapp text-white hover:opacity-90"
          >
            Send your location on WhatsApp
          </a>
          <p class="mt-3 max-w-xs text-[0.9375rem] text-white/60">
            Sharing your live location is the fastest way to be found.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="spine band">
    <div class="grid gap-10 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-5">
        <h2 class="title">What roadside assistance covers</h2>
        <p class="lede mt-5">
          If the fault can't be fixed where you are, we tow you to a network garage.
        </p>
      </div>
      <div class="lg:col-span-7">
        <ul class="border-t border-rule">
          {services.map((s) => (
            <li class="border-b border-rule py-4">
              <a href={serviceUrl(s)} class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1 hover:text-gold-light">
                <span class="subtitle">{s.name}</span>
                <span class="text-[0.9375rem] text-graphite">{s.excerpt}</span>
              </a>
            </li>
          ))}
          {alsoCovered.map((item) => (
            <li class="border-b border-rule py-4">{item}</li>
          ))}
        </ul>
      </div>
    </div>
    <p class="measure mt-12 text-graphite">
      The repair itself is quoted the same way as any other Cars911 job — several garages, written
      prices, your choice. Being towed somewhere doesn't commit you to fixing it there.
    </p>
  </section>
</BaseLayout>
