---
import { appointmentUrl, locationUrl, serviceUrl } from '../../lib/urls';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CtaBand from '../../components/CtaBand.astro';
import PageHead from '../../components/PageHead.astro';
import Rating from '../../components/Rating.astro';
import { actions } from 'astro:actions';
import { db } from '../../db/client';
import { TIER_LABELS, waLink } from '../../lib/site';

const { slug } = Astro.params;
const garage = await db.query.garages.findFirst({
  where: (g, { eq, and }) => and(eq(g.slug, slug!), eq(g.active, true)),
  with: {
    garageServices: { with: { service: { with: { category: true } } } },
    garageLocations: { with: { location: true } },
    reviews: {
      where: (r, { eq }) => eq(r.approved, true),
      orderBy: (r, { desc }) => desc(r.createdAt),
    },
  },
});
if (!garage) return Astro.rewrite('/404/');

const reviewResult = Astro.getActionResult(actions.submitReview);
const avgRating =
  garage.reviews.length > 0
    ? garage.reviews.reduce((sum, r) => sum + r.rating, 0) / garage.reviews.length
    : null;

const schema = avgRating
  ? [
      {
        '@context': 'https://schema.org',
        '@type': 'AutoRepair',
        name: garage.name,
        description: garage.description,
        aggregateRating: {
          '@type': 'AggregateRating',
          ratingValue: avgRating.toFixed(1),
          reviewCount: garage.reviews.length,
        },
      },
    ]
  : [];
---

<BaseLayout title={`${garage.name} — ${TIER_LABELS[garage.tier]}`} description={garage.description} schema={schema}>
  <PageHead trail={[['/garages/', 'Garage network'], ['', garage.name]]} title={garage.name} bookHref={appointmentUrl({ garage: garage.id })} bookLabel="Book this garage">
    {garage.description}
  </PageHead>

  <div class="spine pt-14 pb-20">
    <div class="grid gap-10 lg:grid-cols-3">
      <div class="lg:col-span-2">
        <p class="text-graphite">{TIER_LABELS[garage.tier]}</p>
        <div class="mt-1"><Rating rating={avgRating} count={garage.reviews.length} /></div>

        <dl class="mt-8 flex flex-wrap gap-x-10 gap-y-3">
          {garage.warrantyMonths > 0 && (
            <div>
              <dt class="text-sm text-graphite">Workmanship warranty</dt>
              <dd class="title-sm">{garage.warrantyMonths} months</dd>
            </div>
          )}
          {garage.turnaroundHours && (
            <div>
              <dt class="text-sm text-graphite">Typical turnaround</dt>
              <dd class="title-sm">{garage.turnaroundHours} hours</dd>
            </div>
          )}
          <div>
            <dt class="text-sm text-graphite">Price band</dt>
            <dd class="title-sm">{garage.priceBand}</dd>
          </div>
        </dl>

        <section class="mt-8">
          <h2 class="title-sm">Services offered</h2>
          <ul class="mt-3 flex flex-wrap gap-2">
            {garage.garageServices.map(({ service }) => (
              <li>
                <a
                  href={serviceUrl(service)}
                  class="inline-block rounded-[3px] border border-rule bg-surface px-3 py-1.5 text-sm font-semibold hover:border-gold hover:text-gold-light"
                >
                  {service.name}
                </a>
              </li>
            ))}
          </ul>
        </section>

        <section class="mt-6">
          <h2 class="title-sm">Areas served</h2>
          <ul class="mt-3 flex flex-wrap gap-2">
            {garage.garageLocations.map(({ location }) => (
              <li>
                <a
                  href={locationUrl(location)}
                  class="inline-block rounded-[3px] border border-rule bg-surface px-3 py-1.5 text-sm font-semibold hover:border-gold hover:text-gold-light"
                >
                  {location.name}
                </a>
              </li>
            ))}
          </ul>
        </section>

        <section class="mt-10">
          <h2 class="title-sm">Customer reviews</h2>
          {garage.reviews.length > 0 ? (
            <ul class="mt-4 space-y-4">
              {garage.reviews.map((r) => (
                <li class="rounded-[3px] border border-rule bg-surface p-5">
                  <div class="flex items-center justify-between">
                    <p class="font-medium">{r.authorName}</p>
                    <Rating rating={r.rating} />
                  </div>
                  {r.comment && <p class="mt-2 text-graphite">{r.comment}</p>}
                </li>
              ))}
            </ul>
          ) : (
            <p class="mt-3 text-graphite">No reviews yet — be the first after your visit.</p>
          )}

          <div class="mt-8 sheet p-6">
            <h3 class="subtitle">Used this garage? Leave a review</h3>
            {reviewResult && !reviewResult.error ? (
              <p class="mt-3 rounded-[3px] bg-gold-wash p-3 font-semibold">
                Thanks — your review is in. It appears once our team approves it.
              </p>
            ) : (
              <form method="POST" action={actions.submitReview} class="mt-4 grid gap-4">
                <input type="hidden" name="garageId" value={garage.id} />
                <div class="grid gap-4 sm:grid-cols-2">
                  <div>
                    <label class="field-label" for="rev-name">Your name</label>
                    <input id="rev-name" name="authorName" class="field" required minlength="2" />
                  </div>
                  <div>
                    <label class="field-label" for="rev-rating">Rating</label>
                    <select id="rev-rating" name="rating" class="field" required>
                      <option value="5">5 — excellent</option>
                      <option value="4">4 — good</option>
                      <option value="3">3 — okay</option>
                      <option value="2">2 — poor</option>
                      <option value="1">1 — avoid</option>
                    </select>
                  </div>
                </div>
                <div>
                  <label class="field-label" for="rev-comment">Your experience</label>
                  <textarea id="rev-comment" name="comment" rows="3" class="field"></textarea>
                </div>
                {reviewResult?.error && (
                  <p class="rounded-[3px] bg-alert-wash p-3 text-sm font-semibold text-alert">
                    Could not submit the review — check the fields and try again.
                  </p>
                )}
                <button type="submit" class="btn btn-primary justify-self-start">Submit review</button>
              </form>
            )}
          </div>
        </section>
      </div>

      <aside class="lg:pt-16">
        <div class="sheet p-6">
          <h2 class="subtitle">Book with {garage.name}</h2>
          <a href={appointmentUrl({ garage: garage.id })} class="btn btn-primary mt-4 w-full">Book appointment</a>
          <a href="/book-a-service/" class="btn btn-quiet mt-3 w-full">Compare quotes first</a>
          {garage.whatsapp && (
            <a
              href={waLink(`Hi, I found ${garage.name} on Cars911 and I'd like a quote.`)}
              class="mt-3 block text-center font-medium text-gold-light hover:underline"
            >
              WhatsApp via Cars911
            </a>
          )}
        </div>
      </aside>
    </div>
  </div>

  <CtaBand heading="Want to compare before you book?">Send one request and see what other verified garages quote.</CtaBand>
</BaseLayout>
