---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CtaBand from '../../components/CtaBand.astro';
import PageHead from '../../components/PageHead.astro';
import { actions } from 'astro:actions';

const result = Astro.getActionResult(actions.corporateLead);

const perks = [
  ['One account, every emirate', 'A single point of contact for your whole fleet, wherever your drivers are.'],
  ['Consolidated billing', 'Monthly invoicing across all jobs instead of receipts from a dozen garages.'],
  ['Priority scheduling', 'Fleet vehicles jump the queue — downtime costs you more than it costs a private owner.'],
  ['Reporting', 'Per-vehicle service history and spend, ready for your finance team.'],
];
---

<BaseLayout
  title="Corporate & fleet car servicing in the UAE"
  description="Fleet maintenance through one account: priority scheduling, consolidated billing and per-vehicle reporting across the Cars911 garage network."
>
  <PageHead trail={[['/book/corporate/', 'Corporate booking']]} title="Corporate &amp; fleet servicing" cta={false}>
    Delivery fleets, company cars, rentals — Cars911 manages the servicing so your team
    manages the business.
  </PageHead>

  <div class="spine pt-14 pb-20">
    <div class="grid gap-10 lg:grid-cols-2">
      <div>
        <dl class="border-t border-rule">
          {perks.map(([title, body]) => (
            <div class="border-b border-rule py-5">
              <dt class="subtitle">{title}</dt>
              <dd class="mt-2 text-graphite">{body}</dd>
            </div>
          ))}
        </dl>
      </div>

      <div>
        {result && !result.error ? (
          <div class="sheet p-6">
            <h2 class="subtitle">Thanks — we'll be in touch</h2>
            <p class="mt-2 text-graphite">
              A fleet account manager will contact you within one business day.
            </p>
          </div>
        ) : (
          <form method="POST" action={actions.corporateLead} class="grid gap-4 sheet p-6">
            <h2 class="subtitle">Talk to the fleet team</h2>
            <div>
              <label class="field-label" for="co-company">Company</label>
              <input id="co-company" name="company" class="field" required minlength="2" />
            </div>
            <div class="grid gap-4 sm:grid-cols-2">
              <div>
                <label class="field-label" for="co-name">Contact name</label>
                <input id="co-name" name="contactName" class="field" required minlength="2" />
              </div>
              <div>
                <label class="field-label" for="co-phone">Phone</label>
                <input id="co-phone" name="phone" class="field" required inputmode="tel" />
              </div>
            </div>
            <div>
              <label class="field-label" for="co-email">Work email</label>
              <input id="co-email" name="email" type="email" class="field" required />
            </div>
            <div>
              <label class="field-label" for="co-fleet">Fleet size</label>
              <select id="co-fleet" name="fleetSize" class="field">
                <option value="">Select</option>
                <option>2–10 vehicles</option>
                <option>11–50 vehicles</option>
                <option>51–200 vehicles</option>
                <option>200+ vehicles</option>
              </select>
            </div>
            <div>
              <label class="field-label" for="co-msg">What does your fleet need?</label>
              <textarea id="co-msg" name="message" rows="3" class="field"></textarea>
            </div>
            {result?.error && (
              <p class="rounded-[3px] bg-alert-wash p-3 text-sm font-semibold text-alert">
                Could not send — check the required fields and try again.
              </p>
            )}
            <button type="submit" class="btn btn-primary justify-self-start">Request a callback</button>
          </form>
        )}
      </div>
    </div>
  </div>

  <CtaBand heading="Smaller than a fleet?">A single request works the same way for one car.</CtaBand>
</BaseLayout>
