---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHead from '../../components/PageHead.astro';
import { getEntry, render } from 'astro:content';

const { slug } = Astro.params;
const entry = await getEntry('policies', slug!);
if (!entry) return Astro.rewrite('/404/');
const { Content } = await render(entry);

const fmt = entry.data.updatedAt.toLocaleDateString('en-AE', { day: 'numeric', month: 'long', year: 'numeric' });
---

<BaseLayout title={entry.data.title} description={`Cars911 ${entry.data.title}.`}>
  <PageHead trail={[['', entry.data.title]]} title={entry.data.title} />

  <article class="spine-narrow pt-14 pb-20">
    <p class="mt-2 text-sm text-graphite">Last updated {fmt}</p>
    <div class="prose-cars mt-8">
      <Content />
    </div>
  </article>
</BaseLayout>
